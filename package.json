{
  "name": "pflanzen-gericht",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "verify": "run-s build lint format:check test:unit:run",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:check:*\"",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint . --cache",
    "lint:fix:oxlint": "oxlint . --fix",
    "lint:fix:eslint": "eslint . --fix --cache",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fix": "run-s \"lint:fix:*\" format",
    "prepare": "simple-git-hooks",
    "db:start:local": "supabase start",
    "db:stop:local": "supabase stop",
    "db:types:local": "supabase gen types typescript --local > src/types/database.ts",
    "db:reset:local": "supabase db reset --local",
    "db:push:local": "supabase db push --local",
    "db:push:linked": "supabase db push --linked"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.59.0",
    "oxlint": "~1.74.0",
    "simple-git-hooks": "^2.13.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm verify"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
